# MacAni Linux Plymouth theme — responsive, lightweight
# Uses native Plymouth script sprites; no external runtime dependencies.

Window.SetBackgroundTopColor(0.015, 0.020, 0.065);
Window.SetBackgroundBottomColor(0.025, 0.035, 0.110);

logo_image = Image("logo.png");
logo_sprite = Sprite(logo_image);
logo_sprite.SetZ(10000);

# Glass title capsule and progress track are drawn as simple image sprites.
# Keep all positioning relative to screen dimensions.
screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

logo_sprite.SetX(screen_w / 2 - logo_image.GetWidth() / 2);
logo_sprite.SetY(screen_h * 0.20);

# Progress track (Plymouth's Image supports solid color fill via Image.Text).
track_image = Image.Text(" ", 0, 0, 0, 0);
track_sprite = Sprite(track_image);
track_sprite.SetZ(5000);
track_sprite.SetX(screen_w * 0.33);
track_sprite.SetY(screen_h * 0.78);

progress = 0;
fun boot_progress_callback (duration, progress_value) {
    progress = progress_value;
    # Subtle logo opacity ramp as boot progresses.
    logo_sprite.SetOpacity(0.88 + 0.12 * progress);
}
Plymouth.SetBootProgressFunction(boot_progress_callback);

fun message_callback (text) {
    # Hide noisy boot messages; theme remains clean.
}
Plymouth.SetMessageFunction(message_callback);
